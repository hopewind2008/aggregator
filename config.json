{
  "domains": [],
  "crawl": {
    "enable": true,
    "threshold": 5,
    "exclude": "过期|到期|剩余|官网|购买|广告|付费",
    "singlelink": false,
    "persist": {
      "subscribes": "subscribes",
      "domains": "domains"
    },
    "telegram": {
      "enable": true,
      "pages": 3,
      "exclude": "广告|推广|付费|商业",
      "users": {
        "jichang_list": {
          "enable": true,
          "exclude": "",
          "push_to": ["free"]
        },
        "jichangdaquan": {
          "enable": true,
          "exclude": "",
          "push_to": ["free"]
        },
        "TG_Animes": {
          "enable": true,
          "exclude": "",
          "push_to": ["free"]
        },
        "proxy_list": {
          "enable": true,
          "exclude": "",
          "push_to": ["free"]
        }
      }
    },
    "github": {
      "enable": true,
      "pages": 2,
      "push_to": ["free"],
      "spams": ["spam", "ads", "广告"]
    },
    "google": {
      "enable": false,
      "push_to": ["free"]
    },
    "yandex": {
      "enable": false,
      "push_to": ["free"]
    },
    "twitter": {
      "enable": false
    },
    "repositories": [
      {
        "enable": true,
        "username": "freefq",
        "repo_name": "free",
        "commits": 5,
        "push_to": ["free"]
      },
      {
        "enable": true,
        "username": "aiboboxx",
        "repo_name": "v2rayfree",
        "commits": 3,
        "push_to": ["free"]
      },
      {
        "enable": true,
        "username": "Pawdroid",
        "repo_name": "Free-servers",
        "commits": 3,
        "push_to": ["free"]
      },
      {
        "enable": true,
        "username": "peasoft",
        "repo_name": "NoMoreWalls",
        "commits": 3,
        "push_to": ["free"]
      }
    ],
    "pages": [
      {
        "enable": true,
        "url": "https://raw.githubusercontent.com/freefq/free/master/v2",
        "push_to": ["free"]
      },
      {
        "enable": true,
        "url": "https://raw.githubusercontent.com/aiboboxx/v2rayfree/main/v2",
        "push_to": ["free"]
      }
    ],
    "scripts": []
  },
  "groups": {
    "free": {
      "emoji": true,
      "list": true,
      "regularize": {
        "enable": false,
        "locate": false,
        "residential": false,
        "bits": 2
      },
      "targets": {
        "clash": "free_clash",
        "v2ray": "free_v2ray",
        "singbox": "free_singbox"
      }
    }
  },
  "storage": {
    "type": "gist",
    "items": {
      "free_clash": {
        "type": "gist",
        "filename": "clash.yaml"
      },
      "free_v2ray": {
        "type": "gist",
        "filename": "v2ray.txt"
      },
      "free_singbox": {
        "type": "gist",
        "filename": "singbox.json"
      },
      "subscribes": {
        "type": "gist",
        "filename": "subscribes.txt"
      },
      "domains": {
        "type": "gist",
        "filename": "domains.txt"
      }
    }
  },
  "update": {
    "enable": true,
    "interval": 3600
  },
  "delay": 5000
}
